{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Read(secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(security find-generic-password)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain)",
      "Bash(security dump-keychain *)",
      "Bash(security export)",
      "Bash(security export *)",
      "Bash(terminal-notifier)",
      "Bash(terminal-notifier *)",
      "Bash(/opt/homebrew/bin/terminal-notifier *)",
      "Bash(/usr/local/bin/terminal-notifier *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/plugins/marketplaces/agent-kit/plugins/guard/hooks/python.sh\" \"$HOME/.claude/plugins/marketplaces/agent-kit/plugins/guard/hooks/guard.py\" --managed",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/plugins/marketplaces/agent-kit/plugins/guard/hooks/python.sh\" \"$HOME/.claude/plugins/marketplaces/agent-kit/plugins/guard/hooks/guard.py\" --managed",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
