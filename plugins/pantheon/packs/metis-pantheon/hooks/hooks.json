{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/../_bin/in_repo.py\" \"$HOME/projects/other/mailkeeper\" --always -- python3 -I .claude/hooks/guard_bash.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/../_bin/in_repo.py\" \"$HOME/projects/other/mailkeeper\" --always -- python3 -I .claude/hooks/guard_read.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
