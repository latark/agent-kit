{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(~/ai/pantheon/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pantheon\" view --quiet",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Edit(~/ai/pantheon/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pantheon\" view --quiet",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Write(~/ai/pantheon/**)",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" state-len",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Edit(~/ai/pantheon/**)",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" state-len",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "MultiEdit(~/ai/pantheon/**)",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" state-len",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(pantheon consent *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pantheon\" consent note",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" answer",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/maintenance.json\"; [ -f \"$f\" ] || exit 0; exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" maint-post",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_PID\" in ''|*[!0-9]*) p=nopid ;; *) p=$CLAUDE_PID ;; esac; for f in \"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/ctx/deferred/$p\".*.json; do [ -e \"$f\" ] || exit 0; exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" deferred; done",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/maintenance.json\"; [ -f \"$f\" ] || exit 0; exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" maint-pre",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__qmd__query|mcp__qmd__get|mcp__qmd__multi_get|ReadMcpResourceTool",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" qmd-query",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$PANTHEON_ROLE\" in domain-coordinator|workshop|hq) ;; *) exit 0 ;; esac; grep -qs owner_cap \"${PANTHEON_HOME:-$HOME/ai/pantheon}/schedule.toml\" || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/pantheon\" night agent-gate",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" owner-log",
            "async": true,
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" clock",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" stop",
            "timeout": 15
          }
        ]
      }
    ],
    "DirectoryAdded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" dir-added",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/push\"; [ -d \"$d\" ] || exit 0; exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" push",
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" start",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" rewake",
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/refusal.py\" fail",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/refusal.py\" denied",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/denials.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_PID\" in ''|*[!0-9]*) p=nopid ;; *) p=$CLAUDE_PID ;; esac; for f in \"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/handoff/hint/$p\".*.json; do [ -e \"$f\" ] || exit 0; exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/refusal.py\" batch; done",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$PANTHEON_ROLE\" in ''|hq) exit 0 ;; esac; exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wait-owner.py\"",
            "async": true,
            "timeout": 45
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$PANTHEON_ROLE\" in ''|hq) exit 0 ;; esac; exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wait-owner.py\"",
            "async": true,
            "timeout": 45
          }
        ]
      }
    ]
  }
}
