{
  "mcpServers": {
    "chrome-devtools": {
      "command": "python3",
      "args": [
        "-I",
        "${PANTHEON_PACK_BIN}/env_from.py",
        "--",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1"
      ]
    },
    "metrics": {
      "command": "python3",
      "args": [
        "-I",
        "${PANTHEON_PACK_BIN}/env_from.py",
        "${HOME}/projects/god-proj/app/.env.local",
        "METRICS_URL,METRICS_TOKEN",
        "--",
        "${HOME}/.local/bin/mcp-metrics",
        "-t",
        "stdio"
      ]
    },
    "next-devtools": {
      "command": "python3",
      "args": [
        "-I",
        "${PANTHEON_PACK_BIN}/env_from.py",
        "--",
        "npx",
        "-y",
        "next-devtools-mcp@0.4.0"
      ],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    },
    "shadcn": {
      "command": "python3",
      "args": [
        "-I",
        "${PANTHEON_PACK_BIN}/env_from.py",
        "--",
        "npx",
        "-y",
        "shadcn@4.8.2",
        "mcp"
      ]
    },
    "queue": {
      "command": "python3",
      "args": [
        "-I",
        "${PANTHEON_PACK_BIN}/env_from.py",
        "${HOME}/projects/god-proj/app/.env.local",
        "QUEUE_EMAIL,QUEUE_API_KEY",
        "--",
        "npx",
        "-y",
        "@example/queue-mcp@0.3.0"
      ]
    },
    "docs": {
      "type": "http",
      "url": "https://docs.example.com/mcp"
    }
  }
}
