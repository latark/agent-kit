#!/usr/bin/env python3
"""heavy <команда …> — тяжёлая команда (сборка, тесты, dev-сервер) через общую блокировку (MEM-03).

Одновременно идут не больше двух тяжёлых команд на Mac: два места — ~/.local/state/pantheon/locks/heavy-cmd-1.lock и
heavy-cmd-2.lock. Свободного места нет — команда ждёт и пишет, чего ждёт. Те же места проверяет плановый проход перед своими
тяжёлыми задачами. Файлы мест создаёт `pantheon install` (и `domains build`): роль в песочнице открывает их только на
чтение — flock от этого не зависит. Мест нет — команда идёт без блокировки, а не падает.

  heavy pnpm test
  heavy --server pnpm dev  долгий процесс (dev-сервер): одновременно не больше одного на Mac, второе место всегда
                           остаётся сборкам и тестам — два сервера не повесят всех остальных
  heavy --status          кто занимает места
В окне роли (есть PANTHEON_TMP) команда получает TMPDIR=$PANTHEON_TMP: песочница ставит TMPDIR в /tmp/claude-<uid>, где
сокеты запрещены, и `pnpm check` с tsx падал на listen EPERM; сокеты окну разрешены только в его кэше (metis-0563).
Очередь (metis-0659): места получают по порядку прихода, а не кто первым опросил место. Ждущая команда кладёт билет в
locks/heavy-queue/ (имя — время прихода и pid) и держит на нём flock, пока жива; берёт место, только когда перед ней нет
живого билета. Билеты умерших (блокировка снята системой, в том числе после kill -9) следующий в очереди убирает сам;
пустой незапертый билет моложе TICKET_GRACE (5 с) — только создан и держит очередь, а с временем дальше TICKET_GRACE в
любую сторону (в том числе из будущего) — умерший. Папку
билетов создать или писать в неё нельзя (песочница) — билета нет, команда ждёт опросом мест, как раньше; так же
при ссылке на месте папки. Чужое в папке, что не обычный файл (FIFO, папка), пропускается. Ждущая команда раз в опрос
обновляет время своего билета; билет живого владельца, не обновлённый дольше TICKET_STALE (120 с), — застывший
(процесс остановлен, SIGSTOP или Ctrl-Z): очередь его обходит, но не удаляет — оживший владелец встанет первым.
Возраст считается от прошлого опроса ждущего, а не от «сейчас»: после сна Mac голова очереди не застывает (metis-0805).
`heavy --status` считает только живые билеты. Сервер (--server): за жетон сервера очереди нет (ждёт опросом), а за
два места, как у любой команды, — по порядку прихода.
Команды нет в PATH окна (окно подняли без ~/.zprofile, nvm в PATH не попал — `pnpm` не находился, metis-0569) —
heavy ищет её сам: bin версии node из nvm (alias/default, затем новейшие), Homebrew, ~/.local/bin; нашла — добавляет эту
папку в PATH команды (у pnpm и npx shebang `env node`). Не нашла — код 127 и одна строка, без очереди за местом.
Полный набор (metis-1007): run-tests.py с папками плагинов без --affected/--only (правило — lib/fullsuite.py, то же, что у
outside) занимает ещё и жетон locks/heavy-full.lock — на Mac идёт один полный набор, второй ждёт в очереди так же (за
жетон — опросом, потом за место по порядку прихода; HEAVY_WAIT_MAX и сообщения те же). Узкие команды и одиночные файлы
жетон не берут. Нет файла жетона — heavy создаёт его сам, а в песочнице идёт без него.
Репозиторий «только CI» (metis-1174): ближайший git-корень cwd или пути файла тестов команды содержит .pantheon-verify
со строкой `ci:` и команда — запуск тестов (python [флаги] … test_*.py, run-tests.py, pytest, -m pytest/unittest; за
обёртками VAR=x, env, nice -n 10, timeout 600, uv run --with x, uvx, и в sh/bash -c, -lc) — отказ, код 2, без запуска:
тесты идут в GitHub Actions (итог — gh pr checks <N>). HEAVY_LOCAL_TESTS=1 снимает отказ. Сами роли её в команду не
пишут: её ставят запасные пути с записью — плановый проход (pantheon outside test) и `pantheon review test`, когда
команда — полный набор (FULL_TESTS шлюза) или его узкий вариант (--affected).
  heavy --probe <команда>  проба одного мутанта для argus: в репозитории «только CI» — только один файл тестов
                           (python [флаги] <путь>/test_*.py [аргументы]); run-tests.py, pytest, -m, sh -c, второй
                           test_*.py — отказ, код 2. Предел — PROBE_MAX (120 с; HEAVY_PROBE_MAX может только уменьшить):
                           дольше — группа процессов получает SIGTERM, через 5 с SIGKILL, код 124. Вне такого
                           репозитория — любая команда с тем же пределом. Места — как у обычной команды, жетон
                           полного набора не берёт.
HEAVY_WAIT_MAX=<с> — ждать места не дольше: не дождалась — код 75 без запуска (Stop-хук разработчика так отличает
«очередь» от «красной проверки»). Python 3.9+.
"""
import contextlib
import fcntl
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import time

LOCKS = os.path.join(os.path.realpath(os.environ.get("PANTHEON_STATE") or
                                      os.path.join(os.path.expanduser("~"), ".local", "state", "pantheon")), "locks")
SLOTS = ("heavy-cmd-1", "heavy-cmd-2")
SERVER = "heavy-server"  # жетон долгого процесса: держит его не больше одного сервера
FULL = "heavy-full"  # жетон полного набора тестов: на Mac идёт не больше одного (metis-1007)
WAIT_EXIT = 75
POLL = 0.5  # с между опросами мест

QUEUE = "heavy-queue"  # папка билетов очереди на два места (metis-0659)
TICKET_GRACE = 5  # с: билет только создан, блокировка на нём ещё не взята — не считаем умершим
TICKET_STALE = 120  # с: живой билет не обновлялся дольше — владелец остановлен, очередь его обходит (metis-0659)


def probe(dfd, name, now=None):
    """Состояние билета name в папке очереди: "live" — владелец жив и ждёт; "frozen" — владелец жив, но билет не
    обновлялся дольше TICKET_STALE (остановлен); "young" — только создан, блокировка ещё не взята; "dead" — владелец
    умер, блокировка снята системой; None — не обычный файл или не открыть (FIFO не открываем вслепую и не ждём).
    now — от какого времени считать возраст (по умолчанию — сейчас; Ticket.ahead — время своего прошлого опроса)."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=dfd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None
        age = (time.time() if now is None else now) - st.st_mtime
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return "frozen" if age > TICKET_STALE else "live"
        except OSError:
            return None
        # abs: пустой файл с mtime из будущего (часы назад, touch -t) иначе был бы «young» вечно и держал очередь
        return "dead" if st.st_size > 0 or abs(time.time() - st.st_mtime) > TICKET_GRACE else "young"
    except OSError:
        return None
    finally:
        os.close(fd)


class Ticket:
    """Билет в очереди на места по порядку прихода. Имя — время прихода (нс) и pid, поэтому порядок — по имени.
    Билет держит flock на своём файле, пока его владелец жив: умер (в том числе kill -9) — блокировка снята системой, и
    следующий в очереди убирает билет сам. Папку билетов создать или писать в неё нельзя (песочница роли) — билета
    нет, команда ждёт как раньше, опросом мест."""

    def __init__(self):
        self.fd = self.dfd = self.name = None
        self.prev = self.last = time.time()  # время прошлого и последнего своего опроса (touch)
        qdir = os.path.join(LOCKS, QUEUE)
        try:
            os.makedirs(qdir, exist_ok=True)
            # папку открываем без перехода по ссылке и работаем через неё: heavy идёт и вне песочницы, а ссылка на месте
            # heavy-queue иначе дала бы удалять файлы в чужой папке
            self.dfd = os.open(qdir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            self.name = f"{time.time_ns():020d}-{os.getpid()}"
            self.fd = os.open(self.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=self.dfd)
            fcntl.flock(self.fd, fcntl.LOCK_EX)
            os.write(self.fd, f"{os.getpid()}\n".encode())
        except OSError:
            self.drop()

    def ahead(self):
        """Есть ли перед нами живой билет. Билеты умерших владельцев убирает. Застывший билет (владелец остановлен)
        обходит, не удаляя. Не обычный файл в папке (FIFO, устройство, папка, ссылка) пропускает: не открывает
        вслепую, не ждёт и не удаляет. Возраст чужого билета — от своего прошлого опроса, а не от «сейчас»: после сна
        Mac дольше TICKET_STALE не обновлялся ни один билет, и голову очереди обходил бы тот, кто проснулся первым
        (metis-0805). Сон — пауза и в своём опросе, поэтому он в возраст не идёт; остановленный владелец отстаёт от
        своих же опросов ждущего и через TICKET_STALE застывает, как раньше."""
        if self.fd is None:
            return False
        try:
            names = sorted(os.listdir(self.dfd))
        except OSError:
            return False
        for name in names:
            if name >= self.name:
                break
            got = probe(self.dfd, name, self.prev)
            if got in ("live", "young"):
                return True
            if got == "dead":
                with contextlib.suppress(OSError):
                    os.unlink(name, dir_fd=self.dfd)
        return False

    def touch(self):
        """Ждём дальше: время билета — сейчас. Остановленный владелец его не обновит, и очередь пойдёт мимо."""
        self.prev, self.last = self.last, time.time()
        if self.fd is None:
            return
        try:
            os.utime(self.fd)
        except OSError:  # смена времени запрещена (песочница) — та же запись pid тоже обновляет время файла
            with contextlib.suppress(OSError):
                os.pwrite(self.fd, f"{os.getpid()}\n".encode(), 0)

    def drop(self):
        if self.fd is not None:
            with contextlib.suppress(OSError):
                os.unlink(self.name, dir_fd=self.dfd)
            os.close(self.fd)
        if self.dfd is not None:
            os.close(self.dfd)
        self.fd = self.dfd = self.name = None


def is_full(argv):
    """Полный набор тестов — по тому же правилу, что у outside (lib/fullsuite.py). Не загрузилось — не полный."""
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location(
            "fullsuite", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "fullsuite.py"))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return bool(mod.is_full(argv))
    except Exception as e:  # не загрузилось — не полный, но молча нельзя: жетон тогда не работает
        print(f"heavy: fullsuite не загрузился: {e} — жетон полного набора не работает", file=sys.stderr)
        return False


CI_ONLY_MSG = ("heavy: тесты этого репозитория идут в CI (строка ci: в .pantheon-verify) — итог: gh pr checks <N>; "
               "запасной путь — pantheon outside test")
PYTHON_RE = re.compile(r"python[0-9.]*\Z")
ASSIGN_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
SHELLS = ("sh", "bash", "zsh", "dash")
# обёртки перед программой: {имя: (флаги со значением, сколько позиционных слов до программы)}
WRAPPERS = {"env": ({"-u", "--unset", "-C", "--chdir"}, 0), "time": (set(), 0), "command": (set(), 0),
            "exec": ({"-a"}, 0), "nice": ({"-n", "--adjustment"}, 0), "heavy": (set(), 0),
            "timeout": ({"-s", "--signal", "-k", "--kill-after"}, 1),
            "uvx": ({"--from", "--with", "-p", "--python", "--index", "--index-url"}, 0),
            "uv run": ({"--with", "--with-editable", "--with-requirements", "-p", "--python", "--project", "--directory",
                        "--package", "--extra", "--group", "--env-file", "--index", "-w"}, 0)}
UV_VALUE_OPTS = {"--directory", "--project", "--config-file", "--cache-dir", "--color", "--python", "-p"}
PY_VALUE_SHORT = "XW"  # -X dev, -W error: значение — остаток слова или следующее слово
PY_VALUE_LONG = {"--check-hash-based-pycs"}
PROBE_MAX = 120  # с: предел --probe (metis-1174); HEAVY_PROBE_MAX может его только уменьшить
PROBE_EXIT = 124


def _skip_opts(words, i, takes, positional):
    """Пропустить флаги обёртки (со значением — два слова) и её позиционные слова → индекс программы."""
    while i < len(words) and words[i].startswith("-"):
        if words[i] == "--":
            i += 1
            break
        i += 2 if words[i] in takes else 1
    return i + positional


def _strip_prefix(words):
    """Слова команды без присваиваний VAR=x и обёрток (env, nice -n 10, timeout 600, uv run --with x, …)."""
    i = 0
    while i < len(words):
        w = words[i]
        name = os.path.basename(w)
        if ASSIGN_RE.match(w):
            i += 1
            continue
        if name == "uv":
            j = i + 1
            while j < len(words) and words[j].startswith("-"):
                j += 2 if words[j] in UV_VALUE_OPTS else 1
            if j >= len(words) or words[j] != "run":
                break
            i, name = j, "uv run"
        elif name not in WRAPPERS:
            break
        takes, positional = WRAPPERS[name]
        i = _skip_opts(words, i + 1, takes, positional)
    return words[i:]


def _short_py_flag(w, nxt):
    """Слитные короткие флаги python (-IBc, -mpytest, -Xdev) → (вид, значение, съедено слов) или None (флаг без значения)."""
    letters = w[1:]
    for n, ch in enumerate(letters):
        if ch in "cm" or ch in PY_VALUE_SHORT:
            tail = letters[n + 1:]
            value, used = (tail, 1) if tail else (nxt, 2)
            return ("opt" if ch in PY_VALUE_SHORT else ch), value, used
    return None


def _py_target(words):
    """python [флаги] … → ("script", путь, остальное) | ("m", модуль, остальное) | ("c", код, []) | (None, "", [])."""
    rest, k = words[1:], 0
    while k < len(rest):
        w = rest[k]
        if w == "--":
            k += 1
            break
        if not w.startswith("-") or w == "-":
            break
        if w.startswith("--"):
            k += 2 if w in PY_VALUE_LONG else 1
            continue
        got = _short_py_flag(w, rest[k + 1] if k + 1 < len(rest) else "")
        if got is None:
            k += 1
            continue
        kind, value, used = got
        if kind != "opt":
            return kind, value, rest[k + used:]
        k += used
    if k < len(rest) and rest[k] != "-":
        return "script", rest[k], rest[k + 1:]
    return None, "", []


def _shell_cmd(words):
    """sh/bash/zsh [-l] -c "…" (в том числе слитно -lc, -ec) → строка команды; иначе None."""
    if not words or os.path.basename(words[0]) not in SHELLS:
        return None
    for k, w in enumerate(words[1:], 1):
        if not w.startswith("-") or w.startswith("--"):
            return None
        if "c" in w[1:]:
            return words[k + 1] if k + 1 < len(words) else None
    return None


def _segments(cmd):
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "fullsuite", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "fullsuite.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.shell_segments(cmd)


def _is_test_file(path):
    b = os.path.basename(path)
    return b == "run-tests.py" or (b.startswith("test_") and b.endswith(".py"))


def _walk(words, depth=0):
    """Сегменты команды после обёрток, с раскрытием sh -c (до трёх уровней)."""
    words = _strip_prefix(words)
    cmd = _shell_cmd(words)
    if cmd is None:
        return [words]
    if depth >= 3:
        return []
    return [seg for part in _segments(cmd) for seg in _walk(part, depth + 1)]


def _words_are_tests(words):
    """Одна команда (слова, без sh -c) — запуск тестов: pytest, python … test_*.py | run-tests.py | -m pytest/unittest."""
    if not words:
        return False
    w0 = os.path.basename(words[0])
    if w0 in ("pytest", "py.test"):
        return True
    if not PYTHON_RE.match(w0):
        return False
    kind, value, _ = _py_target(words)
    if kind == "m":
        return value.split(".")[0] in ("pytest", "unittest")
    return kind == "script" and _is_test_file(value)


def is_test_command(argv):
    """argv — запуск тестов (с обёртками и sh -c). Не разобрать — не тест."""
    try:
        return any(_words_are_tests(seg) for seg in _walk(list(argv)))
    except Exception:
        return False


def test_paths(argv):
    """Пути файлов тестов (test_*.py, run-tests.py), которые запускает команда."""
    try:
        out = []
        for seg in _walk(list(argv)):
            if seg and PYTHON_RE.match(os.path.basename(seg[0])):
                kind, value, _ = _py_target(seg)
                if kind == "script" and _is_test_file(value):
                    out.append(value)
        return out
    except Exception:
        return []


def probe_problem(argv):
    """Почему команда не годится для --probe в репозитории «только CI»; годится (один файл test_*.py) — None."""
    words = _strip_prefix(list(argv))
    if not words:
        return "пустая команда"
    w0 = os.path.basename(words[0])
    if w0 in SHELLS:
        return "оболочка (sh -c) не годится"
    if not PYTHON_RE.match(w0):
        return f"{w0} не годится, нужен python"
    kind, value, rest = _py_target(words)
    if kind != "script":
        return f"python -{kind} не годится" if kind else "нет файла тестов"
    b = os.path.basename(value)
    if b == "run-tests.py":
        return "run-tests.py — это набор, а не один файл"
    if not _is_test_file(value):
        return f"{b} — не файл test_*.py"
    if any(_is_test_file(a) for a in rest):
        return "больше одного файла тестов"
    return None


def ci_only_repo(cwd=None):
    """Ближайший git-корень cwd (.git — папка или файл worktree) с .pantheon-verify, где есть строка `ci:`."""
    d = os.path.realpath(cwd or os.getcwd())
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            try:
                with open(os.path.join(d, ".pantheon-verify"), encoding="utf-8") as fh:
                    return any(ln.startswith("ci:") for ln in fh.read().splitlines())
            except OSError:
                return False
        up = os.path.dirname(d)
        if up == d:
            return False
        d = up


def ci_target(argv):
    """Команда трогает репозиторий «только CI»: cwd или git-корень одного из её файлов тестов (абсолютный путь из
    другой папки — тоже)."""
    return ci_only_repo() or any(ci_only_repo(os.path.dirname(os.path.abspath(p))) for p in test_paths(argv))


def refusal(argv, probe_mode):
    """Строка отказа (код 2, без запуска) или None — команда идёт."""
    if probe_mode:
        if not ci_target(argv):
            return None
        why = probe_problem(argv)
        return None if why is None else (f"heavy: --probe в репозитории «только CI» — один файл тестов "
                                         f"(python [флаги] <путь>/test_*.py): {why} — не запускалась")
    if os.environ.get("HEAVY_LOCAL_TESTS") != "1" and is_test_command(argv) and ci_target(argv):
        return CI_ONLY_MSG
    return None


def probe_limit():
    try:
        v = float(os.environ.get("HEAVY_PROBE_MAX") or PROBE_MAX)
    except ValueError:
        v = PROBE_MAX
    return v if 0 < v < PROBE_MAX else PROBE_MAX


def _kill_group(proc):
    """SIGTERM группе процессов, через 5 с — SIGKILL."""
    with contextlib.suppress(OSError):
        os.killpg(proc.pid, signal.SIGTERM)
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    with contextlib.suppress(OSError):
        os.killpg(proc.pid, signal.SIGKILL)
    proc.wait()


def run_cmd(argv, env, limit=None):
    """Запуск с передачей сигналов. limit — предел --probe: своя группа процессов, превысила — убита, код 124."""
    proc = subprocess.Popen(argv, env=env, start_new_session=bool(limit))

    def forward(s, _f):
        if limit:
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, s)
        else:
            proc.send_signal(s)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)
    if not limit:
        return proc.wait()
    try:
        return proc.wait(timeout=limit)
    except subprocess.TimeoutExpired:
        _kill_group(proc)
        print(f"heavy: --probe дольше {limit:g} с — процесс остановлен (SIGTERM, через 5 с SIGKILL), код {PROBE_EXIT}",
              file=sys.stderr)
        return PROBE_EXIT


def try_slot(names=SLOTS):
    for name in names:
        p = os.path.join(LOCKS, name + ".lock")
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError:
            if name != FULL:
                continue
            try:  # файл жетона полного набора ещё не создан (старая установка) — создаём; нельзя (песочница) — без него
                fd = os.open(p, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
            except OSError:
                return -1, name
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd, name
        except BlockingIOError:
            os.close(fd)
    return None, None


def queue_len():
    """Сколько живых билетов в очереди: умершие и застывшие не в счёт, папку не меняем."""
    try:
        dfd = os.open(os.path.join(LOCKS, QUEUE), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return 0
    try:
        return sum(1 for name in os.listdir(dfd) if probe(dfd, name) in ("live", "young"))
    except OSError:
        return 0
    finally:
        os.close(dfd)


def status():
    n = queue_len()
    if n:
        print(f"очередь на места: {n}")
    for name in SLOTS + (SERVER, FULL):
        p = os.path.join(LOCKS, name + ".lock")
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError:
            print(f"{name}: нет файла места")
            continue
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            print(f"{name}: свободно")
            fcntl.flock(fd, fcntl.LOCK_UN)
        except BlockingIOError:
            print(f"{name}: занято")
        os.close(fd)
    return 0


def tmp_env():
    """Окружение команды: в окне роли TMPDIR — папка tmp кэша окна (там сокеты разрешены)."""
    env = dict(os.environ)
    tmp = env.get("PANTHEON_TMP")
    if tmp and os.path.isdir(tmp):
        env["TMPDIR"] = tmp
    return env


def _vkey(v):
    return tuple(int(x) if x.isdigit() else 0 for x in v.lstrip("v").split("."))


def fallback_dirs():
    """Где искать команду, которой нет в PATH окна: bin версии node из nvm (по alias/default первой, дальше новейшие),
    Homebrew, ~/.local/bin."""
    home = os.path.expanduser("~")
    nvm = os.environ.get("NVM_DIR") or os.path.join(home, ".nvm")
    root = os.path.join(nvm, "versions", "node")
    try:
        vers = sorted((v for v in os.listdir(root) if v.startswith("v")), key=_vkey, reverse=True)
    except OSError:
        vers = []
    try:
        with open(os.path.join(nvm, "alias", "default"), encoding="utf-8") as fh:
            want = fh.read().strip().lstrip("v")
    except OSError:
        want = ""
    first = [v for v in vers if want and (v[1:] == want or v[1:].startswith(want + "."))]
    order = first[:1] + [v for v in vers if v not in first[:1]]
    return [os.path.join(root, v, "bin") for v in order] + ["/opt/homebrew/bin", "/usr/local/bin",
                                                          os.path.join(home, ".local", "bin")]


def resolve(argv, env):
    """→ (argv, env) с найденной командой; команду не нашли — None. Путь со слэшем и команду из PATH не трогает."""
    name = argv[0]
    if "/" in name or shutil.which(name, path=env.get("PATH") or os.defpath):
        return argv, env
    for d in fallback_dirs():
        if shutil.which(name, path=d):
            env = dict(env)
            env["PATH"] = d + os.pathsep + env["PATH"] if env.get("PATH") else d
            return argv, env
    return None


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 2
    if argv[0] == "--status":
        return status()
    server = argv[0] == "--server"
    probe_mode = argv[0] == "--probe"
    if server or probe_mode:
        argv = argv[1:]
    if not argv:
        print(__doc__)
        return 2
    why = refusal(argv, probe_mode)
    if why:
        print(why, file=sys.stderr)
        return 2
    limit = probe_limit() if probe_mode else None
    env = tmp_env()
    found = resolve(argv, env)
    if not found:
        print(f"heavy: команда {argv[0]!r} не найдена ни в PATH, ни в nvm, Homebrew и ~/.local/bin — не запускалась",
              file=sys.stderr)
        return 127
    argv, env = found
    if not any(os.path.exists(os.path.join(LOCKS, n + ".lock")) for n in SLOTS):
        print("heavy: мест блокировки нет (pantheon install их создаёт) — запускаю без неё", file=sys.stderr)
        return run_cmd(argv, env, limit)
    try:
        wait_max = float(os.environ.get("HEAVY_WAIT_MAX") or 0)
    except ValueError:
        wait_max = 0
    held, waited = [], 0
    full = not server and not probe_mode and is_full(argv)  # --probe жетон полного набора не берёт
    need = ([((FULL,), "полный набор тестов уже идёт (на Mac один)")] if full else []) + \
        ([((SERVER,), "сервер уже запущен другой ролью")] if server else []) + \
        [(SLOTS, "оба места заняты другими тяжёлыми командами")]
    for names, what in need:
        ticket = Ticket() if names == SLOTS else None  # очередь — только на два места, не на жетон сервера
        try:
            fd = None if ticket and ticket.ahead() else try_slot(names)[0]
            while fd is None:
                if wait_max and waited >= wait_max:
                    print(f"heavy: {what} — не дождалась места за {int(waited)} с, команда не запускалась",
                          file=sys.stderr)
                    return WAIT_EXIT
                if waited % 60 == 0:  # шаг опроса 0,5 с: освободившееся место берётся сразу, а не через 2 с
                    print(f"heavy: {what} — жду ({int(waited // 60)} мин)", file=sys.stderr)
                time.sleep(POLL)
                waited += POLL
                if ticket:
                    ticket.touch()
                fd = None if ticket and ticket.ahead() else try_slot(names)[0]
        finally:
            if ticket:
                ticket.drop()
        if fd >= 0:  # -1 — жетон полного набора создать нельзя: идём без него, как без мест
            held.append(fd)
    code = run_cmd(argv, env, limit)
    for fd in held:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
