{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(~/ai/pantheon/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pantheon\" view --quiet",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Edit(~/ai/pantheon/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pantheon\" view --quiet",
            "async": true,
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" answer",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/maintenance.json\"; [ -f \"$f\" ] || exit 0; exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" maint-post",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/maintenance.json\"; [ -f \"$f\" ] || exit 0; exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" maint-pre",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__qmd__query|mcp__qmd__get|mcp__qmd__multi_get|ReadMcpResourceTool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" qmd-query",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" owner-log",
            "async": true,
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" stop",
            "timeout": 15
          }
        ]
      }
    ],
    "DirectoryAdded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" dir-added",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${PANTHEON_STATE:-$HOME/.local/state/pantheon}/push\"; [ -d \"$d\" ] || exit 0; exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" push",
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" start",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx.py\" rewake",
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
